* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
# Normalize line endings to LF for all text files
* text=auto eol=lf

# Explicitly force LF for files that must not have CRLF
*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.mjs       text eol=lf
*.json      text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.md        text eol=lf
*.env       text eol=lf
*.sh        text eol=lf
Dockerfile* text eol=lf
.dockerignore text eol=lf
.gitignore  text eol=lf

# Binary files — no conversion
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.eot       binary
*.pdf       binary
*.xlsx      binary
*.zip       binary
