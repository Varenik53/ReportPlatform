{
  "name": "@reportplatform/reports",
  "version": "1.0.0",
  "description": "Report definitions and registry",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "report:new": "node ./scripts/generate-report-handler.mjs"
  },
  "dependencies": {
    "@reportplatform/shared": "workspace:*",
    "exceljs": "^4.4.0",
    "pdfkit": "^0.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pdfkit": "^0.17.5",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  }
}
